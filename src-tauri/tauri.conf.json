{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinuxZ",
  "version": "0.1.0",
  "identifier": "io.szymon.linuxz",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "LinuxZ",
        "width": 1460,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
